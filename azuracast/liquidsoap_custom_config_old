# If you want to add small text AD in the end of each song (song name/artist will be raplaced for adv_sec seconds)
# then alter your custom liquidsoap config

# AzuraCast station custom configuration: Pre-Fade section (№3)
# Apply this content through Station Profile -> Broadcasting -> Edit Liquidsoap Configuration.
# AzuraCast stores this section as `backend_config.custom_config` and generates liquidsoap.liq from it.

advert_input = radio

# Pre-Broadcast section (№4)
#
# AzuraCast stores this section as
# `backend_config.custom_config` and generates liquidsoap.liq from it.
#
# This block runs after AzuraCast metadata feedback and jingle-mode handling,
# immediately before Icecast and HLS outputs. Do not add it to the generated
# liquidsoap.liq file directly.

# Outgoing metadata advert for eligible AutoDJ tracks.
advert_output = radio

advert_show_before_end_seconds = 10.
advert_artist = "AzuraVote"
advert_title = "Vote for songs at https://jam5.uk"

advert_current_song_id = ref("")
advert_current_sq_id = ref("")
advert_fired = ref(false)

def advert_metadata_value(metadata, key) =
    list.assoc(default="", key, metadata)
end

# Track the current AutoDJ queue occurrence. Do not restore output metadata
# from this pre-crossfade source: it can run ahead of audible output.
def remember_advert_track(metadata) =
    advert_current_song_id := advert_metadata_value(metadata, "song_id")
    advert_current_sq_id := advert_metadata_value(metadata, "sq_id")
    advert_fired := false
end

# Require the final source to still be broadcasting this exact AutoDJ
# occurrence. Missing final metadata is deliberately ineligible.
def final_output_matches_advert_track(song_id, sq_id) =
    final_metadata = advert_output.last_metadata()
    if null.defined(final_metadata) then
        output_metadata = null.get(final_metadata)
        advert_metadata_value(output_metadata, "song_id") == song_id and
            advert_metadata_value(output_metadata, "sq_id") == sq_id
    else
        false
    end
end

def show_end_metadata_advert(position, metadata) =
    song_id = advert_metadata_value(metadata, "song_id")
    sq_id = advert_metadata_value(metadata, "sq_id")

    if song_id != "" and sq_id != "" and
        song_id == advert_current_song_id() and
        sq_id == advert_current_sq_id() and
        not advert_fired() and
        final_output_matches_advert_track(song_id, sq_id)
    then
        # Do not create an artificial boundary or expose internal IDs.
        advert_fired := true
        advert_output.insert_metadata(
            new_track=false,
            [("artist", advert_artist), ("title", advert_title)]
        )
    end
end

source.methods(advert_input).on_track(
    synchronous=false,
    remember_advert_track
)

source.methods(advert_input).on_position(
    position=advert_show_before_end_seconds,
    remaining=true,
    allow_partial=false,
    synchronous=false,
    show_end_metadata_advert
)
