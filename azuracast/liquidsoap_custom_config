# If you want to add small text AD in the end of each song (song name/artist will be raplaced for adv_sec seconds)
# then alter your custom liquidsoap config

# AzuraCast station custom configuration: Pre-Fade section (№3)
# Apply this content through Station Profile -> Broadcasting -> Edit Liquidsoap Configuration.
# AzuraCast stores this section as `backend_config.custom_config` and generates liquidsoap.liq from it.

advert_input = radio

# Pre-Broadcast section (№4)
#
# AzuraCast stores this section as
# `backend_config.custom_config` and generates liquidsoap.liq from it.
#
# This block runs after AzuraCast metadata feedback and jingle-mode handling,
# immediately before Icecast and HLS outputs. Do not add it to the generated
# liquidsoap.liq file directly.

advert_output = radio

# Configuration
adv_sec = 3.
adv_meta = [("artist", "AzuraVote"), ("title", "Vote for songs at https://jam5.uk")]

# State Tracking: Bundling song_id and sq_id into a single tuple, plus the fired boolean
adv_state = ref(("", "")) 
adv_fired = ref(false)

# Helper to safely fetch metadata values
def get_val(m, k) = list.assoc(default="", k, m) end

# 1. Track new song occurrences
def on_new_track(m) =
    adv_state := (get_val(m, "song_id"), get_val(m, "sq_id"))
    adv_fired := false
end

# 2. Trigger advert near the end of the track
# FIX: Added 'position' as the first argument as required by on_position
def on_track_end(position, m) =
    let (tgt_song, tgt_sq) = (get_val(m, "song_id"), get_val(m, "sq_id"))
    let (cur_song, cur_sq) = !adv_state
    
    # Safely extract the final output metadata
    last_meta = advert_output.last_metadata()
    out_meta = if null.defined(last_meta) then null.get(last_meta) else [] end

    # Ensure valid track, state matches, and advert hasn't fired yet
    if tgt_song != "" and tgt_song == cur_song and tgt_sq == cur_sq and not !adv_fired then
        # Ensure the final output is actually playing this track right now
        if get_val(out_meta, "song_id") == tgt_song and get_val(out_meta, "sq_id") == tgt_sq then
            adv_fired := true
            advert_output.insert_metadata(new_track=false, adv_meta)
        end
    end
end

# Bind the methods to the input source
in_methods = source.methods(advert_input)
in_methods.on_track(synchronous=false, on_new_track)
in_methods.on_position(
    position=adv_sec, 
    remaining=true, 
    allow_partial=false, 
    synchronous=false, 
    on_track_end
)
